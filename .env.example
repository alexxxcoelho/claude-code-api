# ──────────────────────────────────────────────────────────────────────────
# Authentication mode
# ──────────────────────────────────────────────────────────────────────────
# AUTH_MODE=oauth  -> use the globally-installed `claude` CLI with the
#                     credentials in ~/.claude (your Claude subscription /
#                     Pro / Max login). No API key needed.
# AUTH_MODE unset  -> use the bundled @anthropic-ai/claude-code with an API key
#                     (ANTHROPIC_API_KEY below).
AUTH_MODE=oauth

# Required ONLY in API-key mode (AUTH_MODE unset). Ignored in oauth mode.
# ANTHROPIC_API_KEY=sk-ant-api03-xxxxx

# ──────────────────────────────────────────────────────────────────────────
# Client authentication (STRONGLY recommended when exposed beyond localhost)
# ──────────────────────────────────────────────────────────────────────────
# When set, clients must send `Authorization: Bearer <key>` (or `x-api-key`).
# When unset, the API is OPEN and a warning is logged at startup.
PROXY_API_KEY=change-me-to-a-long-random-string

# ──────────────────────────────────────────────────────────────────────────
# Claude tool / permission policy (security-sensitive)
# ──────────────────────────────────────────────────────────────────────────
# CLAUDE_TOOLS controls `claude --tools`:
#   ""          -> disable ALL tools (default, safe: text only, no RCE surface)
#   "default"   -> enable all tools (Bash/Edit/Write/Read…)
#   "Read,Edit" -> a specific allow-list
# Leave empty for a pure chat/completions proxy reachable by untrusted clients.
CLAUDE_TOOLS=

# Set to "true" to add --dangerously-skip-permissions (bypasses ALL permission
# checks). Only meaningful when tools are enabled. NEVER enable on an endpoint
# reachable by untrusted clients.
CLAUDE_SKIP_PERMISSIONS=false

# ──────────────────────────────────────────────────────────────────────────
# Pool configuration (optional)
# ──────────────────────────────────────────────────────────────────────────
POOL_SIZE=5
IDLE_TIMEOUT_MS=300000
PORT=3000
